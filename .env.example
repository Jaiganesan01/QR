# Environment configuration for QShield (Template / Example only)
# Copy to .env and configure appropriate values for your deployment.
# NEVER commit real production secrets, API keys, or database files to version control.

FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

# Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Administrative Authorization Token
# Required in production to access /admin telemetry and metrics.
ADMIN_API_KEY=change-to-a-secure-random-token-for-admin-observability

# Upload limits (5MB = 5242880 bytes)
MAX_CONTENT_LENGTH=5242880

# Image Processing Bounds (Decompression bomb defenses)
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
MAX_IMAGE_PIXELS=16000000

# SQLite Database Location
DATABASE_PATH=instance/qshield.db

# In-Memory Rate Limiting Controls
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT_WINDOW=60
RATELIMIT_DECODE=30
RATELIMIT_ANALYZE=60
RATELIMIT_REPUTATION=15
RATELIMIT_REDIRECT=15
RATELIMIT_REPORT=20

# Optional Threat Intelligence API keys (Consent-driven lookups)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
